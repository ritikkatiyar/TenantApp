# Database Configuration
MYSQL_DATABASE=tenant_living
MYSQL_USER=tenant_living
MYSQL_PASSWORD=secure_password_here
MYSQL_ROOT_PASSWORD=root_password_here

# Backend Security
APP_JWT_SECRET=your_32_character_secret_key_here
APP_CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000

# Spring Profiles
SPRING_PROFILES_ACTIVE=prod
